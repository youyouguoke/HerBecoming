// HerBecoming Database Schema v1.0
// PostgreSQL 15+ with pgvector extension

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ============================================================================
// 1. Users & Authentication
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  name         String?
  avatarUrl    String?
  locale       String    @default("en") // en | zh
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  // Auth
  accounts Account[]

  // User-owned data
  conversations Conversation[]
  memories      Memory[]
  decisions     Decision[]
  reflections   Reflection[]
  usageRecords  UsageRecord[]
  feedbacks     Feedback[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // oauth | credentials
  provider          String // google | wechat
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ============================================================================
// 2. Anonymous Sessions
// ============================================================================

model AnonymousSession {
  id              String    @id @default(cuid())
  fingerprintId   String    @unique // browser fingerprint / cookie id
  dailyQuotaReset DateTime  @default(now())
  createdAt       DateTime  @default(now())
  lastActiveAt    DateTime?

  conversations Conversation[]
  usageRecords  UsageRecord[]

  // Migration target when user logs in
  migratedToUserId String?

  @@map("anonymous_sessions")
}

// ============================================================================
// 3. Conversations & Messages
// ============================================================================

model Conversation {
  id        String   @id @default(cuid())
  title     String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership: either anonymous session or logged-in user
  userId             String?
  anonymousSessionId String?

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  messages Message[]
  state    ConversationState?

  @@index([userId])
  @@index([anonymousSessionId])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
  system
  safety
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  // Structured metadata for this turn
  metadata       Json?       @default("{}")
  createdAt      DateTime    @default(now())

  // AI-only fields
  intent                String? // reflection | decision | goal | emotional_support | ...
  primaryDomain         String?
  domains               String[] // [RELATIONSHIPS, CAREER, LIFE_DECISIONS]
  riskLevel             String? // normal | elevated | crisis
  retrievedKnowledgeIds String[]
  memoryIds             String[]
  model                 String?
  tokensUsed            Int?
  latencyMs             Int?

  // Safety / quality flags
  safetyChecked Boolean @default(false)
  outputSafety  Json? // { passed: bool, flags: [] }

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Running state of a conversation for multi-turn reasoning
model ConversationState {
  id             String @id @default(cuid())
  conversationId String @unique

  mainProblem    String?  @db.Text
  userPosition   String?  @db.Text
  unresolved     String[]
  mentorFocus    String?
  lastQuestion   String?  @db.Text
  emotionalState String?
  decisionStage  String?

  summary          String?   @db.Text // rolling summary for context window management
  summaryUpdatedAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_states")
}

// ============================================================================
// 4. Knowledge Base
// ============================================================================

enum KnowledgeDomain {
  SELF
  RELATIONSHIPS
  CAREER
  LIFE_DECISIONS
  COMMUNICATION
}

enum KnowledgeType {
  principle
  concept
  framework
  observation
  case_pattern
  communication
  reflection
  quote
  safety_rule
}

enum SafetyClass {
  SAFE
  CONTEXTUAL
  REFRAME
  DO_NOT_GENERATE
}

enum EvidenceLevel {
  SOURCE_PRINCIPLE
  OBSERVATION
  FRAMEWORK
  CASE_PATTERN
  OPINION
  SCRIPT
  SAFETY_RULE
}

model KnowledgeNode {
  id       String          @id
  domain   KnowledgeDomain
  category String // e.g., agency, boundaries, value_creation
  title    String
  titleEn  String?

  // Core content
  coreIdea               String   @db.Text
  coreIdeaEn             String?  @db.Text
  mentorInterpretation   String?  @db.Text
  mentorInterpretationEn String?  @db.Text
  counterpoints          String[] @db.Text
  applicationContexts    String[]
  reflectionQuestions    String[] @db.Text
  examples               String[] @db.Text

  // Classification
  knowledgeType KnowledgeType
  safetyClass   SafetyClass
  evidenceLevel EvidenceLevel

  // Source traceability
  sourceReference String?
  sourceType      String? // user_provided_knowledge_base | derived | public_research

  // Usage tracking
  retrievalCount  Int       @default(0)
  lastRetrievedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  outgoingRelations KnowledgeRelation[] @relation("SourceNode")
  incomingRelations KnowledgeRelation[] @relation("TargetNode")
  embedding         KnowledgeEmbedding?

  @@index([domain, category])
  @@index([knowledgeType])
  @@index([safetyClass])
  @@map("knowledge_nodes")
}

enum RelationType {
  RELATED
  SUPPORTS
  CONTRASTS
  PREREQUISITE
  REFRAMES
  APPLIES_TO
  EXAMPLE_OF
  DERIVED_FROM
}

model KnowledgeRelation {
  id           String       @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  relationType RelationType
  weight       Float        @default(1.0)

  sourceNode KnowledgeNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode KnowledgeNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, relationType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("knowledge_relations")
}

model KnowledgeEmbedding {
  id              String @id @default(cuid())
  knowledgeNodeId String @unique

  // pgvector: 1536 dimensions for text-embedding-3-small / bge-m3 etc.
  embedding Unsupported("vector(1536)")

  // Multilingual: store separate embeddings if needed
  embeddingLang String @default("zh") // zh | en | multilingual
  model         String @default("text-embedding-3-small")

  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@index([embeddingLang])
  @@map("knowledge_embeddings")
}

// ============================================================================
// 5. Mentor Configuration
// ============================================================================

model MentorPersona {
  id       String  @id @default(cuid())
  version  String  @unique
  isActive Boolean @default(false)

  identity           Json // { role, style, personality }
  philosophy         Json // [] of principles
  communication      Json // { tone, avoid }
  decisionPhilosophy Json

  systemPrompt   String @db.Text
  reasoningRules Json // ["MR-01", "MR-02", ...]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mentor_personas")
}

// ============================================================================
// 6. User Memory
// ============================================================================

enum MemoryType {
  TOPIC
  GOAL
  DECISION
  INSIGHT
  VALUE
  PATTERN
  PREFERENCE
}

model Memory {
  id        String     @id @default(cuid())
  userId    String
  type      MemoryType
  content   String     @db.Text
  contentEn String?    @db.Text

  // Why was it saved
  sourceMessageId      String?
  sourceConversationId String?

  // Vector for retrieval
  embedding Unsupported("vector(1536)")?

  // User control
  isArchived Boolean @default(false)
  isDeleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, isDeleted])
  @@map("memories")
}

// ============================================================================
// 7. Journal: Decisions & Reflections
// ============================================================================

enum DecisionStatus {
  ACTIVE
  ARCHIVED
  REVIEWED
}

model Decision {
  id     String  @id @default(cuid())
  userId String
  title  String
  topic  String? // domain/category

  context         String?        @db.Text
  whatIWant       String?        @db.Text
  whatIFear       String?        @db.Text
  options         Json? // [{ text, pros, cons }]
  tradeoffs       String?        @db.Text
  currentThinking String?        @db.Text
  nextAction      String?        @db.Text
  reviewDate      DateTime?
  outcome         String?        @db.Text
  status          DecisionStatus @default(ACTIVE)

  // Linked conversation
  conversationId String?
  messageId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("decisions")
}

model Reflection {
  id             String  @id @default(cuid())
  userId         String
  question       String? @db.Text
  context        String? @db.Text
  userInsight    String? @db.Text
  aiInsight      String? @db.Text
  keyRealization String? @db.Text

  conversationId String?
  messageId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reflections")
}

// ============================================================================
// 8. Safety Logs
// ============================================================================

enum RiskLevel {
  normal
  elevated
  crisis
}

model SafetyLog {
  id String @id @default(cuid())

  userId             String?
  anonymousSessionId String?
  conversationId     String?
  messageId          String?

  riskLevel         RiskLevel
  riskCategory      String? // self_harm | violence | dependency | manipulation | ...
  confidence        Float?
  userMessage       String    @db.Text
  recommendedAction String?
  responseGiven     String?   @db.Text

  // Crisis resources provided
  resources Json?

  createdAt DateTime @default(now())

  @@index([riskLevel, createdAt])
  @@index([anonymousSessionId])
  @@index([userId])
  @@map("safety_logs")
}

// ============================================================================
// 9. Usage & Quotas
// ============================================================================

model UsageRecord {
  id String @id @default(cuid())

  userId             String?
  anonymousSessionId String?

  date       DateTime @default(now()) @db.Date
  usedCount  Int      @default(0)
  lastUsedAt DateTime @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@unique([anonymousSessionId, date])
  @@map("usage_records")
}

// ============================================================================
// 10. Feedback & Quality
// ============================================================================

model Feedback {
  id             String  @id @default(cuid())
  userId         String
  messageId      String
  conversationId String?

  // PRD-aligned questions
  helpedSeeDifferently String? // not_really | a_little | yes | definitely
  wouldReturn          String? // no | maybe | yes | definitely
  rating               Int?
  comment              String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}
